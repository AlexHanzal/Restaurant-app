# ============================================================================
# .env.example — every environment variable this app reads.
#
# Generated 2026-07-29 by sweeping `process.env.*` across src/, so it is
# complete and matches the code exactly. PLACEHOLDER VALUES ONLY — never
# commit a filled-in .env (see .gitignore).
#
# Copy to .env and fill in. Everything except JWT_SECRET is optional; the
# app degrades gracefully (see the notes on each block).
# ============================================================================

# ── CORE ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Absolute path to the SQLite file. Defaults to <cwd>/data/app.db.
# On a host with a mounted disk, point this AT that disk or you lose all
# data on every redeploy.
SQLITE_PATH=/var/data/app.db

# ── SECRETS ─────────────────────────────────────────────────────────────
# REQUIRED when NODE_ENV=production — the server refuses to start without
# it rather than run with a guessable secret. Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# Optional but recommended in production. If unset, a random secret is
# generated per process start, which means every outstanding CSRF cookie is
# invalidated on restart/redeploy (the frontend recovers automatically, but
# anyone mid-action gets one retried request).
CSRF_SECRET=

# ── ACCESS CONTROL ──────────────────────────────────────────────────────
# Comma-separated extra origins allowed to call the API cross-origin. The
# app is single-origin in normal deployment, so leave this EMPTY unless you
# genuinely run the frontend on a separate host. The request's own origin
# is always allowed.
ALLOWED_ORIGINS=

# Per-account login lockout (cross-IP). Defaults: 6 failures / 15 minutes.
LOGIN_LOCKOUT_THRESHOLD=6
LOGIN_LOCKOUT_MINUTES=15

# ── SPEND CAP ───────────────────────────────────────────────────────────
# Hard ceiling on SMS sent per calendar day across the whole process,
# shared by the reservation and reorder verification flows. This is the
# backstop that per-IP and per-phone rate limits cannot provide: it bounds
# the worst case when an attacker has many IP addresses. Default 200.
# Set it to roughly 3x a busy day's real volume.
SMS_DAILY_CAP=200

# ── SMS (Twilio) ────────────────────────────────────────────────────────
# If unset, verification codes are logged to the console instead of sent.
# That means NO real SMS goes out — safe for local testing, useless in
# production (customers can never receive their code).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+420000000000

# ── E-MAIL (SMTP) ───────────────────────────────────────────────────────
# If unset, confirmation e-mails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=objednavky@example.cz

# ── PAYMENTS (GoPay) ────────────────────────────────────────────────────
# If GOID/CLIENT_ID/CLIENT_SECRET are not all set, online-card payments are
# SIMULATED and logged to the console — no real gateway is contacted and no
# money moves. Keep GOPAY_SANDBOX=true until you have tested end to end.
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_SANDBOX=true
# Both optional — derived from the incoming request's own origin if unset.
GOPAY_RETURN_URL=
GOPAY_NOTIFICATION_URL=

# ── BUSINESS IDENTITY (receipts + legal pages) ──────────────────────────
BUSINESS_NAME=Ukázková restaurace s.r.o.
BUSINESS_ICO=12345678
BUSINESS_DIC=CZ12345678
BUSINESS_ADDRESS=Náměstí Svobody 1, 602 00 Brno
BUSINESS_VAT_PAYER=false

# ── RESERVATION REMINDERS ───────────────────────────────────────────────
# How often the reminder scanner runs, in milliseconds. Default 15 minutes.
RESERVATION_REMINDER_INTERVAL_MS=900000
