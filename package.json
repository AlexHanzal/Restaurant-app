{
  "name": "restaurant-system",
  "version": "1.0.0",
  "private": true,
  "description": "Czech restaurant web app: SMS-verified table reservations, delivery ordering with GoPay, QR self-order at the table, kitchen/driver/admin surfaces, offline-first POS and EET 2.0 reporting.",
  "main": "src/server/server.js",
  "scripts": {
    "start": "node src/server/server.js",
    "dev": "node src/server/server.js",
    "server": "node src/server/server.js",
    "test": "node --test",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:smoke": "node --test \"tests/smoke/**/*.test.js\""
  },
  "keywords": [
    "restaurant",
    "reservations",
    "delivery",
    "pos",
    "eet",
    "gopay",
    "express",
    "sqlite"
  ],
  "author": "Alex Hanzal",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "esbuild": "^0.28.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "subset-font": "^2.5.0",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20 <27"
  }
}
